<?xml version="1.0" encoding="UTF-8"?>
<!--
  Bonanza gRPC chạy qua grpc-java-netty, mặc định log DEBUG mọi frame HTTP/2 (OUTBOUND/INBOUND
  HEADERS + DATA cho từng request). Ở scale production (1000 VU × 60 phút) file gatling.log sẽ
  phình lên hàng GB và bóp nghẹt throughput. Root WARN cắt sạch phần đó, giữ nguyên console
  summary + assertion output mà scripts/run-variant.sh cần parse.
-->
<configuration>

	<appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
		<encoder>
			<pattern>%d{HH:mm:ss.SSS} [%-5level] %logger{15} - %msg%n%rEx</pattern>
		</encoder>
		<immediateFlush>false</immediateFlush>
	</appender>

	<!-- uncomment and set to DEBUG to log failing gRPC calls only -->
	<!--<logger name="com.github.phisgr.gatling.grpc" level="DEBUG" />-->

	<root level="WARN">
		<appender-ref ref="CONSOLE" />
	</root>

</configuration>
